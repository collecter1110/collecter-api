SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Local auth (replace Supabase Auth)
AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=180

# Resend (OTP email)
RESEND_API_KEY=your-resend-api-key
SMTP_FROM="Collecter <no-reply@example.com>"

# Google OAuth (id_token 검증용 client_id)
# iOS/Android/Web client_id가 다르면 콤마로 구분해 나열
GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
APPLE_APP_BUNDLE_ID=your-app-bundle-id

# S3 (image uploads)
# Provide ONE of the bucket name variables below.
AWS_REGION=ap-northeast-2
AWS_BUCKET_NAME=your-s3-bucket-name
# AWS_BUCKET=your-s3-bucket-name
# S3_BUCKET_NAME=your-s3-bucket-name
# S3_BUCKET=your-s3-bucket-name

# If you run locally with static credentials, set these.
# In production, prefer IAM Role / managed credentials and omit them.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

IMAGE_CDN_BASE_URL=your-image-url
WEB_PUBLIC_ORIGIN=web-public-origin