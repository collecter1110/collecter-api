# 백엔드 API (서버 컴포넌트에서 사용)
API_BASE_URL=https://api.collecter.kr

# 이미지 베이스 (next/image remotePatterns 검증용 — 클라 컴포넌트에서도 사용 가능)
NEXT_PUBLIC_IMAGE_BASE_URL=https://image.collecter.kr

# 앱 열기 / 스토어 폴백 (iOS only)
NEXT_PUBLIC_APP_SCHEME=collecterapp
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
